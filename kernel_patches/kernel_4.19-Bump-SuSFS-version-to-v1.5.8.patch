 		hash_len = hash_name(nd->path.dentry, name);
 
@@ -2238,6 +2276,40 @@ static int link_path_walk(const char *name, struct nameidata *nd)
 				name = this.name;
 			}
 		}
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+    if (dentry->d_inode) {
+        if (susfs_is_base_dentry_sdcard_dir(dentry) &&
+            susfs_is_sus_sdcard_d_name_found(name))
+        {
+            if (nd->flags & ND_STATE_RENAMEAT) {
+                do {
+                    name++;
+                } while (likely(*name != '/') && *name != '\0');
+                while (*name == '/')
+                    name++;
+                if (!*name) {
+                    return -EPERM;
+                }
+                return -ENOENT;
+            } else if (nd->flags & ND_STATE_FILENAME_CREATE) {
+                if (nd->last.name[nd->last.len] && !(nd->flags & LOOKUP_DIRECTORY)) {
+                    return -ENOENT;
+                } else {
+                    do {
+                        name++;
+                    } while (likely(*name != '/') && *name != '\0');
+                    while (*name == '/')
+                        name++;
+                    if (!*name) {
+                        return -EACCES;
+                    }
+                    return -ENOENT;
+                }
+            }
+            return -ENOENT;
+        }
+    }
+#endif
 
 		nd->last.hash_len = hash_len;
 		nd->last.name = name;
@@ -2293,12 +2365,6 @@ static int link_path_walk(const char *name, struct nameidata *nd)
 			}
 			return -ENOTDIR;
 		}
