 	if (unlikely(IS_DEADDIR(dir)))
@@ -1665,9 +1697,8 @@ static struct dentry *__lookup_hash(const struct qstr *name,
 		dentry = old;
 	}
 #ifdef CONFIG_KSU_SUSFS_SUS_PATH
